 /* Lab Task List:
  * Input an unknown number of employees 
  * Determine and display the gross pay for each employ
  * Company pays straight time for the first 40 hours worked by each employee 
  * Hours x Rate
  * Straight time plus time-and-a-half for all hours worked in excess of 40 hours
  * Input the number of hours worked and hourly rate for each of the employees
  * Determine and display the employee’s gross pay
  * At the end, print the total gross pay for all employees
  * Use the sentinel control Algorithm
  */

package IndLabCH06;

import java.util.Scanner;
import java.text.DecimalFormat;

public class IndLabCH06 
{
	public static void main(String[] args) 
	{
	final int SENTINEL = -1;
	int employees;
	double hours ;
	double rate = 0 ;
	double grossPay = 0;

	Scanner scan = new Scanner(System.in);
	DecimalFormat percent = new DecimalFormat( "$0.00" );
	
		System.out.println( "This program determine and display the ross Pay for each employ" );
	      
		//EMPLOYEES
		System.out.println( "Number of Employees: " );
		employees = scan.nextInt();
		while ( employees <= 0 );
		
		//RATE OF PAY	
		System.out.println( "Rate of pay: " );
		rate = scan.nextDouble();
		while ( rate <= 0 );
		
		//HOURS WORKED
		System.out.println( "Hours Worked : ");
		hours = scan.nextDouble();		    
		while ( hours <= 0 )
		
		//GROSS PAY
			while (employees != SENTINEL);
			for (int i = 0; i < employees; i++) 
		 	{
				if (hours <= 40)
		 	{
		 	grossPay = hours * rate;
		 	System.out.println( "The Gross Pay for Employee " + (i+1) + " is " + percent.format(grossPay));
		 	}
				else if (hours > 40) 
		 	{
				System.out.println("Overtime Time Notice: ");

				double TimeandHalf = hours / 2;
		 		grossPay = (hours + TimeandHalf) * rate;
		 		System.out.println( "\nThe Gross Pay for Employee " + (i+1) + " is " + percent.format(grossPay));

	 		}
				
		 }
			//TOTAL GROSS PAY 			
	 		double TotalgrossPay = grossPay * employees;
	 		System.out.println( "\nThe Total Gross Pay For all employees is " + percent.format(TotalgrossPay));
	}
}
